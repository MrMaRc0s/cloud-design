# Not active yet - copy to backend.tf (and run `terraform init -migrate-state`
# or a fresh `terraform init`) once:
#   1. Both developers have agreed on the AWS account/region (Phase 0 of the
#      handoff plan) and applied terraform/bootstrap/ to create the bucket.
#   2. The shared root that wires both developers' modules together exists
#      (this repo doesn't have that root yet - each module is still
#      validated standalone).
#
# Uses Terraform's native S3 locking (`use_lockfile`, Terraform >= 1.10) -
# no separate DynamoDB table to create or pay for.

terraform {
  backend "s3" {
    bucket       = "REPLACE-ME-state-bucket-name" # from terraform/bootstrap output state_bucket_name
    key          = "cloud-design/terraform.tfstate"
    region       = "eu-central-1"
    encrypt      = true
    use_lockfile = true
  }
}
